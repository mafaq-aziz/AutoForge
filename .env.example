# AutoForge runtime configuration.
# Copy this file to `.env` and fill in values for your own environment.
# Never commit real secrets; `.env` is gitignored.

# Structured-log verbosity for simulation runs.
AUTOFORGE_LOG_LEVEL=INFO

# SQLite database used by the local web app (PostgreSQL in production deployments).
AUTOFORGE_DATABASE_URL=sqlite:///./autoforge.db

# Default RNG seed for demo/reproducible simulation runs.
AUTOFORGE_DEFAULT_SEED=20260809

# Directory where simulation run logs are written.
AUTOFORGE_LOG_DIR=./.autoforge/logs
